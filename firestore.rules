rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore is not used by the OneUPay application.
    // All application data is stored in Firebase Realtime Database.
    // Deny all Firestore client access unless a future reviewed feature needs it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}